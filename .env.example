# =====================================================================
# SEO Evi — Ortam değişkenleri
# Bu dosyayı `.env.local` olarak kopyalayın ve değerleri doldurun.
# Gerçek anahtarları asla kaynak koda yazmayın.
# =====================================================================

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://seoevi.com.tr

# --- Supabase ---
# Proje ayarları > API bölümünden alınır.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# Yalnızca sunucu tarafında kullanılır. Tarayıcıya asla gönderilmez.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx
# Migration çalıştırmak için doğrudan bağlantı dizesi (npm run db:migrate).
SUPABASE_DB_URL=postgresql://postgres:SIFRE@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# --- DataForSEO ---
# Yalnızca sunucu tarafında kullanılır.
DATAFORSEO_LOGIN=eposta@ornek.com
DATAFORSEO_PASSWORD=xxxxxxxxxxxxxxxx
# Canlı ortamda 'live', geliştirmede maliyeti düşürmek için 'sandbox' kullanılabilir.
DATAFORSEO_MODE=live

# --- Yapay zekâ sağlayıcısı (Anthropic) ---
AI_PROVIDER=anthropic
AI_PROVIDER_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
AI_MODEL=claude-sonnet-5

# --- Arka plan işleri ---
# /api/isler/calistir uç noktasını korumak için rastgele uzun bir değer üretin.
# Bu değer aynı zamanda ücretsiz araç kotalarında özet tuzu olarak kullanılır.
CRON_SECRET=degistirin-uzun-rastgele-bir-deger

# --- Harcama koruması ---
# Platformun günlük DataForSEO harcama tavanı (USD). Aşıldığında yeni
# maliyetli analiz başlatılmaz; hata ya da saldırı durumunda zararı sınırlar.
GUNLUK_HARCAMA_TAVANI_USD=25
# Google Sıra Bulucu'nun günlük toplam sorgu tavanı.
# Kişisel kota (günde 3) VPN/cihaz değiştirilerek aşılabilir; asıl koruma budur.
SIRA_BULUCU_GUNLUK_TAVAN=400

# --- Google Search Console (OAuth 2.0) ---
# Search Console verisi siteye özeldir; API ANAHTARI İLE ERİŞİLEMEZ.
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID
# (Web application) oluşturun ve yönlendirme adresi olarak şunu ekleyin:
#   https://seoevi.com.tr/api/gsc/callback
#   http://localhost:3000/api/gsc/callback   (geliştirme)
# Ayrıca "Google Search Console API"yi etkinleştirmeniz gerekir.
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxx
